[Unit]
Description=Survival Simulator joint planner API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=van
WorkingDirectory=./src_survival
Environment=PYTHONUNBUFFERED=1
Environment=SURVIVAL_PORT=9082
ExecStart=./src_survival/.venv/bin/survival-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
